<?xml version="1.0"?>
<!--
  ABB IRB 1200-5/0.9 robot arm — primitive-shape URDF.

  6-DOF industrial arm; payload 5 kg, reach 0.9 m. Link transforms and
  joint axes follow the standard DH parameters of the IRB 1200-5/0.9
  (Khalil convention, lengths in meters):

    Link  a       alpha     d        joint range (rad)
    1     0       -pi/2     0.3991   [-2.967,  2.967]
    2     0.350    0        0        [-1.745,  2.356]   (offset -pi/2)
    3     0.042   -pi/2     0        [-3.491,  1.222]
    4     0        pi/2     0.351    [-4.712,  4.712]
    5     0       -pi/2     0        [-2.269,  2.269]
    6     0        0        0.082    [-6.981,  6.981]

  Visuals use simple cylinders and boxes — not the official ABB meshes —
  so the file is self-contained, license-clean, and small. Naming
  follows the project convention used by ur5.urdf: link0..link6,
  joint1..joint6, plus a fixed ee_link at the flange.

  All masses and inertias are coarse approximations; sufficient for IK
  and visualization, not for high-fidelity dynamics.
-->
<robot name="abb_irb1200">

  <!-- =========================== base ========================= -->
  <link name="link0">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.09"/></geometry>
      <material name="abb_orange"><color rgba="0.95 0.45 0.05 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.09"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <!-- =========================== joint 1 — base rotation (waist) ========================= -->
  <joint name="joint1" type="revolute">
    <parent link="link0"/>
    <child link="link1"/>
    <origin xyz="0 0 0.3991" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="100" velocity="5.027"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><cylinder length="0.30" radius="0.075"/></geometry>
      <material name="abb_orange"><color rgba="0.95 0.45 0.05 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><cylinder length="0.30" radius="0.075"/></geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.008"/>
    </inertial>
  </link>

  <!-- =========================== joint 2 — shoulder ========================= -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="1.570796 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.745" upper="2.356" effort="100" velocity="4.189"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0.175 0 0" rpy="0 1.570796 0"/>
      <geometry><cylinder length="0.350" radius="0.06"/></geometry>
      <material name="abb_orange"><color rgba="0.95 0.45 0.05 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.175 0 0" rpy="0 1.570796 0"/>
      <geometry><cylinder length="0.350" radius="0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="6.0"/>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.07"/>
    </inertial>
  </link>

  <!-- =========================== joint 3 — elbow ========================= -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.350 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.491" upper="1.222" effort="100" velocity="5.236"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0.021 0 0" rpy="0 1.570796 0"/>
      <geometry><cylinder length="0.042" radius="0.055"/></geometry>
      <material name="abb_orange"><color rgba="0.95 0.45 0.05 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.021 0 0" rpy="0 1.570796 0"/>
      <geometry><cylinder length="0.042" radius="0.055"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <origin xyz="0.021 0 0" rpy="0 0 0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <!-- =========================== joint 4 — wrist roll ========================= -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.042 0 0" rpy="-1.570796 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-4.712" upper="4.712" effort="40" velocity="6.981"/>
  </joint>

  <link name="link4">
    <visual>
      <origin xyz="0 0 0.1755" rpy="0 0 0"/>
      <geometry><cylinder length="0.351" radius="0.04"/></geometry>
      <material name="abb_grey"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1755" rpy="0 0 0"/>
      <geometry><cylinder length="0.351" radius="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.1755" rpy="0 0 0"/>
      <inertia ixx="0.022" ixy="0" ixz="0" iyy="0.022" iyz="0" izz="0.0016"/>
    </inertial>
  </link>

  <!-- =========================== joint 5 — wrist pitch ========================= -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.351" rpy="1.570796 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.269" upper="2.269" effort="40" velocity="7.069"/>
  </joint>

  <link name="link5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.07" radius="0.035"/></geometry>
      <material name="abb_grey"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.07" radius="0.035"/></geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- =========================== joint 6 — wrist yaw ========================= -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.981" upper="6.981" effort="20" velocity="10.472"/>
  </joint>

  <link name="link6">
    <visual>
      <origin xyz="0 0 0.041" rpy="0 0 0"/>
      <geometry><cylinder length="0.082" radius="0.03"/></geometry>
      <material name="abb_grey"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.041" rpy="0 0 0"/>
      <geometry><cylinder length="0.082" radius="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.041" rpy="0 0 0"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- =========================== tool / end-effector frame ========================= -->
  <joint name="ee_fixed_joint" type="fixed">
    <parent link="link6"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0.082" rpy="0 0 0"/>
  </joint>

  <link name="ee_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
      <material name="abb_red"><color rgba="0.9 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

</robot>
